<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= fileName %> -- E2EE File</title>
  <meta name="robots" content="noindex, nofollow">
  <% if (typeof analyticsHtml !== 'undefined' && analyticsHtml) { %><%- analyticsHtml %><% } %>
  <style>
    :root{--background:#121212;--text:rgba(255,255,255,0.87);--text-muted:rgba(255,255,255,0.6);--text-bright:rgba(255,255,255,1);--card-bg:rgba(30,30,30,1);--card-hover:rgba(40,40,40,1);--border:rgba(60,60,60,1);--hover-border:rgba(80,80,80,1);--button-bg:rgba(60,60,60,1);--button-hover:rgba(80,80,80,1);--highlight-bg:rgba(80,80,80,1);--highlight-text:rgba(255,255,255,1);--link-color:#90caf9;--link-hover:#64b5f6;--link-bright:#bbdefb;--primary-color:#90caf9;--notification-success-bg:rgba(76,175,80,1);--notification-error-bg:rgba(244,67,54,1);--notification-info-bg:rgba(33,150,243,1);--input-bg:rgba(0,0,0,0.2);--progress-bg:rgba(255,255,255,0.08);--progress-fill:var(--primary-color);--space-1:0.25rem;--space-2:0.5rem;--space-3:0.75rem;--space-4:1rem;--space-5:1.5rem;--space-6:2rem;--space-8:3rem;--space-12:4rem}
    @font-face{font-family:'Ubuntu Mono';src:url('/fonts/ubuntu-mono-latin-400-normal.woff2') format('woff2');font-weight:400;font-style:normal;font-display:swap}
    @font-face{font-family:'Ubuntu Mono';src:url('/fonts/ubuntu-mono-latin-700-normal.woff2') format('woff2');font-weight:700;font-style:normal;font-display:swap}
    *{margin:0;padding:0;box-sizing:border-box}
    body{background:var(--background);color:var(--text);font-family:"Ubuntu Mono",monospace;min-height:100vh;display:flex;align-items:center;justify-content:center;padding:var(--space-5)}
    .e2ee-container{width:100%;max-width:520px}
    .e2ee-card{background:var(--card-bg);border:1px solid var(--border);border-radius:12px;padding:var(--space-6)}.e2ee-card .e2ee-filename{font-size:1.1rem;color:var(--text-bright);margin-bottom:var(--space-2);font-weight:400}.e2ee-card .e2ee-meta{color:var(--text-muted);font-size:.85rem;margin-bottom:var(--space-5)}
    .e2ee-badge{display:inline-flex;align-items:center;gap:.35rem;background:rgba(144,202,249,0.12);color:var(--primary-color);padding:.2rem .6rem;border-radius:4px;font-size:.78rem;margin-bottom:var(--space-4)}.e2ee-badge svg{width:12px;height:12px;fill:currentColor}
    .e2ee-info-row{font-size:.85rem;color:var(--text-muted);margin-bottom:var(--space-5)}
    .e2ee-input-group{margin-bottom:var(--space-4)}.e2ee-input-group label{display:block;font-size:.8rem;color:var(--text-muted);margin-bottom:var(--space-2)}.e2ee-input-group input{width:100%;padding:.65rem .85rem;background:var(--input-bg);border:1px solid var(--border);border-radius:8px;color:var(--text);font-family:"Ubuntu Mono",monospace;font-size:.9rem;outline:none;transition:border-color .2s}.e2ee-input-group input:focus{border-color:var(--primary-color)}.e2ee-input-group input::placeholder{color:var(--text-muted);opacity:.5}
    .e2ee-button{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;width:100%;padding:.75rem 1.25rem;border:none;border-radius:8px;font-family:"Ubuntu Mono",monospace;font-size:.9rem;cursor:pointer;transition:all .2s;background:var(--button-bg);color:var(--text);border:1px solid var(--border)}.e2ee-button:hover{background:var(--button-hover);border-color:var(--hover-border)}.e2ee-button:disabled{opacity:.4;cursor:not-allowed}.e2ee-btn-primary{background:var(--primary-color);color:#000;border-color:var(--primary-color);font-weight:700}.e2ee-btn-primary:hover{filter:brightness(1.1)}.e2ee-btn-danger{background:rgba(244,67,54,0.15);color:#ff8a80;border-color:rgba(244,67,54,0.3)}.e2ee-btn-danger:hover{background:rgba(244,67,54,0.25)}.e2ee-btn-group{display:flex;gap:var(--space-3);margin-top:var(--space-4)}
    .e2ee-status-text{text-align:center;margin-top:var(--space-4);font-size:.82rem;color:var(--text-muted);min-height:1.2em}.e2ee-status-text.error{color:#ff8a80}.e2ee-status-text.success{color:#69f0ae}
    .e2ee-progress-bar{width:100%;height:6px;background:var(--progress-bg);border-radius:3px;overflow:hidden;margin:var(--space-5) 0 var(--space-2);display:none}.e2ee-progress-bar .e2ee-progress-fill{height:100%;background:var(--progress-fill);width:0%;transition:width .3s ease}
    .js-only{display:none}.js-ready .js-only{display:block}
    .noscript-block{display:block;margin-top:var(--space-4);padding-top:var(--space-4);border-top:1px solid var(--border)}.noscript-block p{color:var(--text-muted);font-size:.82rem;margin-bottom:var(--space-3)}
    @media(max-width:480px){.e2ee-container{padding:0}.e2ee-card{border-radius:8px;padding:var(--space-4)}}
  </style>
  <link rel="stylesheet" href="/style.min.css">
</head>
<body>
<div class="e2ee-container">
  <div class="e2ee-card">
    <div class="e2ee-badge">
      <svg viewBox="0 0 24 24"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1s3.1 1.39 3.1 3.1v2z"/></svg>
      end-to-end encrypted (beta)
    </div>

    <h2 class="e2ee-filename"><%= fileName %></h2>
    <p class="e2ee-meta"><%= formattedSize %></p>

    <p class="e2ee-info-row">AES-256-GCM + PBKDF2</p>

    <!-- JS-dependent UI -->
    <div class="js-only">
      <form id="e2eeForm" action="#">
        <div class="e2ee-input-group" id="passphraseGroup">
          <label for="passphrase">passphrase</label>
          <input type="password" id="passphrase" placeholder="enter passphrase (auto-filled from link)" autocomplete="off" spellcheck="false">
        </div>
      </form>

      <!-- Thin progress bar -->
      <div class="e2ee-progress-bar" id="progressBar">
        <div class="e2ee-progress-fill" id="progressFill"></div>
      </div>

      <div id="e2eeStatusText" class="e2ee-status-text"></div>

      <div class="e2ee-btn-group" id="btnGroup">
        <button class="e2ee-button e2ee-btn-primary" id="downloadBtn">download & decrypt</button>
      </div>

      <hr style="border:none;border-top:1px solid var(--border);margin:var(--space-4) 0">

      <details>
        <summary style="color:var(--text-muted);font-size:.82rem;padding:.25rem 0;cursor:pointer;user-select:none">terminal commands</summary>
        <div style="margin-top:var(--space-3)">
          <pre id="commandPre" style="background:var(--input-bg);border:1px solid var(--border);border-radius:8px;padding:var(--space-3);font-size:.78rem;color:var(--text-muted);overflow-x:auto;white-space:pre-wrap;word-break:break-all;user-select:all;line-height:1.5"></pre>
        </div>
      </details>
    </div>

    <!-- Noscript fallback -->
    <noscript>
      <div class="noscript-block">
        <p>javascript is required to decrypt in your browser.</p>
        <p style="margin-bottom:var(--space-3)">you can use the commands below to download and decrypt via terminal. the passphrase is after #k= in the url.</p>
        <div style="margin-bottom:var(--space-3)">
          <div style="font-size:.75rem;color:var(--text-muted);margin-bottom:var(--space-1)">macos / linux</div>
          <pre style="background:var(--input-bg);border:1px solid var(--border);border-radius:8px;padding:var(--space-3);font-size:.78rem;color:var(--text-muted);overflow-x:auto;white-space:pre-wrap;word-break:break-all;user-select:all;line-height:1.5;margin-bottom:var(--space-3)">curl -o "<%= fileName %>.ltr" "<%= protocol %>://<%= host %>/files/<%= publicId %>/<%= encodeURIComponent(fileName) %>.ltr" \
  && decrypt-ltr "<%= fileName %>.ltr" "&lt;passphrase&gt;" \
  && rm "<%= fileName %>.ltr"</pre>
        </div>
        <div>
          <div style="font-size:.75rem;color:var(--text-muted);margin-bottom:var(--space-1)">windows (powershell)</div>
          <pre style="background:var(--input-bg);border:1px solid var(--border);border-radius:8px;padding:var(--space-3);font-size:.78rem;color:var(--text-muted);overflow-x:auto;white-space:pre-wrap;word-break:break-all;user-select:all;line-height:1.5">curl.exe -o "<%= fileName %>.ltr" "<%= protocol %>://<%= host %>/files/<%= publicId %>/<%= encodeURIComponent(fileName) %>.ltr"`nDecrypt-LTR "<%= fileName %>.ltr" "&lt;passphrase&gt;"`nRemove-Item "<%= fileName %>.ltr"</pre>
        </div>
      </div>
    </noscript>
  </div>
</div>

<script nonce="<%= nonce %>" data-cfasync="false">
(function() {
  document.body.classList.add('js-ready');

  var ID = '<%= publicId %>';
  var FILENAME = '<%= fileName.replace(/'/g, "\\'").replace(/\\/g, "\\\\") %>';
  var FILESIZE = <%= fileSize %>;
  var BASE_URL = '<%= `${protocol}://${host}` %>';

  var passphraseInput = document.getElementById('passphrase');
  var downloadBtn = document.getElementById('downloadBtn');
  var statusEl = document.getElementById('e2eeStatusText');
  var progressBar = document.getElementById('progressBar');
  var progressFill = document.getElementById('progressFill');
  var btnGroup = document.getElementById('btnGroup');
  var commandPre = document.getElementById('commandPre');

  var STATE_IDLE = 0, STATE_DOWNLOADING = 1, STATE_PAUSED = 2, STATE_DECRYPTING = 3, STATE_DONE = 4;
  var state = STATE_IDLE;
  var abortController = null;
  var pwFragment = '';
  var retryCount = 0;
  var MAX_RETRIES = 2;
  var stuckTimer = null;
  var lastReceivedBytes = 0;
  var received = 0;
  var total = 0;

  // Read passphrase from URL fragment
  try {
    var hash = window.location.hash;
    if (hash && hash.length > 3) {
      var params = new URLSearchParams(hash.substring(1));
      var k = params.get('k');
      if (k) {
        pwFragment = k;
        passphraseInput.value = k;
        document.getElementById('passphraseGroup').style.display = 'none';
        history.replaceState(null, '', window.location.pathname + window.location.search);
      }
    }
  } catch(e) {}

  function formatSize(bytes) {
    if (bytes === 0) return '0 B';
    var u = ['B','KB','MB','GB','TB'];
    var i = Math.floor(Math.log(bytes) / Math.log(1024));
    return (bytes / Math.pow(1024, i)).toFixed(i > 0 ? 1 : 0) + ' ' + u[i];
  }

  function setProgress(pct) {
    progressFill.style.width = pct + '%';
  }

  function setStatus(msg, type) {
    statusEl.textContent = msg;
    statusEl.className = 'e2ee-status-text' + (type ? ' ' + type : '');
  }

  function showPauseResume() {
    downloadBtn.textContent = 'pause';
    downloadBtn.className = 'e2ee-button e2ee-btn-danger';
  }

  function showIdle() {
    state = STATE_IDLE;
    downloadBtn.textContent = 'download & decrypt';
    downloadBtn.className = 'e2ee-button e2ee-btn-primary';
    downloadBtn.disabled = false;
    setProgress(0);
    if (abortController) { abortController.abort(); abortController = null; }
  }

  function addRestartBtn() {
    var restartBtn = document.createElement('button');
    restartBtn.textContent = 'restart';
    restartBtn.className = 'e2ee-button';
    restartBtn.onclick = function() {
      this.remove();
      showIdle();
      startDownload();
    };
    btnGroup.appendChild(restartBtn);
  }

  // Generate commands on page load
  function updateCommands() {
    var k = encodeURIComponent(passphraseInput.value || pwFragment);
    if (!k) { commandPre.textContent = '# enter a passphrase first'; return; }
    var url = BASE_URL + '/files/' + ID + '/' + encodeURIComponent(FILENAME) + '.ltr';
    commandPre.textContent = '# macos / linux\ncurl -o "' + FILENAME + '.ltr" "' + url + '" \\\n  && decrypt-ltr "' + FILENAME + '.ltr" "' + k + '" \\\n  && rm "' + FILENAME + '.ltr"\n\n# windows (powershell)\ncurl.exe -o "' + FILENAME + '.ltr" "' + url + '"`nDecrypt-LTR "' + FILENAME + '.ltr" "' + k + '"`nRemove-Item "' + FILENAME + '.ltr"';
  }
  if (pwFragment) updateCommands();

  passphraseInput.addEventListener('input', updateCommands);

  downloadBtn.addEventListener('click', function() {
    if (state === STATE_DOWNLOADING) {
      if (abortController) abortController.abort();
      state = STATE_PAUSED;
      downloadBtn.textContent = 'resume';
      downloadBtn.className = 'e2ee-button e2ee-btn-primary';
      clearTimeout(stuckTimer);
      setStatus('paused');
      return;
    }
    if (state === STATE_PAUSED) {
      startDownload();
      return;
    }
    if (state === STATE_IDLE) {
      startDownload();
    }
  });

  window.addEventListener('beforeunload', function(e) {
    if (state === STATE_DOWNLOADING || state === STATE_DECRYPTING) {
      e.preventDefault();
      e.returnValue = 'Download in progress. Are you sure you want to leave?';
      return e.returnValue;
    }
  });

  function startDownload() {
    var passphrase = passphraseInput.value.trim();
    if (!passphrase) {
      setStatus('enter a passphrase', 'error');
      passphraseInput.focus();
      return;
    }

    state = STATE_DOWNLOADING;
    retryCount = 0;
    received = 0;
    lastReceivedBytes = 0;
    progressBar.style.display = 'block';
    showPauseResume();
    setStatus('downloading...');
    updateCommands();

    doFetch(passphrase);
  }

  function doFetch(passphrase) {
    abortController = new AbortController();
    var signal = abortController.signal;

    // Stuck detection: if no bytes received in 10s, report
    lastReceivedBytes = received;
    stuckTimer = setInterval(function() {
      if (received === lastReceivedBytes && state === STATE_DOWNLOADING) {
        setStatus('stalled -- no data received for 10s, retrying...', 'error');
        // Abort and retry
        if (abortController) abortController.abort();
        clearInterval(stuckTimer);
        if (retryCount < MAX_RETRIES) {
          retryCount++;
          setStatus('retry ' + retryCount + '/' + MAX_RETRIES, 'error');
          doFetch(passphrase);
        } else {
          state = STATE_PAUSED;
          downloadBtn.textContent = 'resume';
          downloadBtn.className = 'e2ee-button e2ee-btn-primary';
          setStatus('download stalled after ' + MAX_RETRIES + ' retries -- click resume or restart', 'error');
          addRestartBtn();
        }
      }
      lastReceivedBytes = received;
    }, 10000);

    fetch(BASE_URL + '/files/' + ID + '/' + encodeURIComponent(FILENAME) + '.ltr', {
      signal: signal
    }).then(function(res) {
      if (!res.ok) throw new Error('download failed: ' + res.status);
      total = parseInt(res.headers.get('Content-Length')) || FILESIZE;
      var reader = res.body.getReader();
      var chunks = [];

      function pump() {
        return reader.read().then(function(r) {
          if (r.done) {
            clearInterval(stuckTimer);
            var blob = new Blob(chunks);
            return blob.arrayBuffer();
          }
          chunks.push(r.value);
          received += r.value.length;
          var pct = Math.round((received / total) * 50);
          setProgress(pct);
          setStatus(formatSize(received) + ' / ' + formatSize(total));
          return pump();
        });
      }
      return pump();
    }).then(function(buffer) {
      clearInterval(stuckTimer);
      state = STATE_DECRYPTING;
      setStatus('decrypting...');
      downloadBtn.disabled = true;

      return new Promise(function(resolve, reject) {
        var worker = new Worker('/e2ee-worker.js');
        worker.onmessage = function(e) {
          var msg = e.data;
          if (msg.type === 'error') { reject(new Error(msg.error)); worker.terminate(); return; }
          if (msg.type === 'fileDecrypted') { resolve(msg); worker.terminate(); }
        };
        worker.onerror = function(err) { reject(err); worker.terminate(); };
        worker.postMessage({ type: 'decryptFile', fileData: buffer, passphrase: passphrase }, [buffer]);
      });
    }).then(function(result) {
      state = STATE_DONE;
      setProgress(100);
      var displayName = result.fileName || FILENAME;
      setStatus('saving ' + displayName, 'success');

      var blob = new Blob([result.decryptedData], { type: result.mimeType || 'application/octet-stream' });
      var url = URL.createObjectURL(blob);
      var a = document.createElement('a');
      a.href = url;
      a.download = displayName;
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(function() { URL.revokeObjectURL(url); }, 30000);

      downloadBtn.textContent = 'done';
      downloadBtn.className = 'e2ee-button';
      downloadBtn.disabled = true;
      setTimeout(showIdle, 5000);
    }).catch(function(err) {
      clearInterval(stuckTimer);
      if (err.name === 'AbortError') {
        // Aborted by pause or stuck detection retry — already handled
        if (state === STATE_DOWNLOADING) return; // retry is running
        return;
      }
      var msg = err.message || 'unknown error';
      if (msg.includes('OperationError') || msg.includes('GCM') || msg.includes('auth') || msg.includes('decrypt')) {
        msg = 'wrong passphrase or corrupted file';
      }

      if (retryCount < MAX_RETRIES && state === STATE_DOWNLOADING) {
        retryCount++;
        setStatus('retry ' + retryCount + '/' + MAX_RETRIES + ': ' + msg, 'error');
        setTimeout(function() { doFetch(passphrase); }, 1000);
        return;
      }

      setStatus('error: ' + msg, 'error');
      state = STATE_PAUSED;
      downloadBtn.textContent = 'resume';
      downloadBtn.className = 'e2ee-button e2ee-btn-primary';
      addRestartBtn();
    });
  }

  // Auto-start if passphrase was in URL and auto-download not disabled
  var autoDownload = true;
  try {
    var stored = localStorage.getItem('e2ee_auto_download');
    if (stored !== null) autoDownload = stored !== 'false';
  } catch(e) {}
  if (pwFragment && autoDownload) {
    setTimeout(startDownload, 300);
  }
})();
</script>
</body>
</html>