{
  "name": "litter",
  "version": "2.0.0",
  "description": "file hosting with telegram as storage backend",
  "main": "src/index.js",
  "bin": {
    "litter": "bin/litter.js"
  },
  "scripts": {
    "build:minify": "cleancss -o public/css/style.min.css public/css/style.css && terser public/js/main.js -c -m -o public/js/main.min.js && terser public/js/shared.js -c -m -o public/js/shared.min.js && terser public/js/misc.js -c -m -o public/js/misc.min.js",
    "prestart": "npm run build:minify",
    "start": "node src/index.js",
    "start:debug": "DEBUG=true node src/index.js --debug",
    "dev": "nodemon src/index.js",
    "dev:debug": "DEBUG=true nodemon src/index.js --debug",
    "litter": "node bin/litter.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "file-hosting",
    "telegram",
    "storage"
  ],
  "author": "M1noa",
  "license": "MIT",
  "dependencies": {
    "@umami/node": "^0.4.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-validator": "^7.3.2",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.6",
    "helmet": "^8.3.0",
    "input": "^1.0.1",
    "multer": "^2.2.0",
    "node-fetch": "^3.3.2",
    "pg": "^8.23.0",
    "telegram": "^2.26.22",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "clean-css-cli": "^5.6.3",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "terser": "^5.51.0"
  }
}
