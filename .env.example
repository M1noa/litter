# litter — file hosting configuration
# copy to .env and fill in your values
# run `npx litter setup` for an interactive wizard

# === site identity ===
SITE_NAME=Litter
SITE_URL=https://your-domain.com
SITE_DESCRIPTION=Free file hosting service. Simple, fast, and reliable.
SITE_KEYWORDS=file host, file hosting, free file hosting
SITE_AUTHOR=Your Name
CONTACT_EMAIL=you@example.com
DMCA_EMAIL=dmca@example.com

# === file limits ===
# max file size in gb (default: 80)
MAX_FILE_SIZE_GB=80

# === seo / crawling ===
# set to false to disallow search engine indexing via robots.txt
ALLOW_SEARCH_INDEXING=true
# set to false to block ai crawlers (gptbot, claudebot, etc) via robots.txt
ALLOW_AI_SCRAPING=true

# === analytics ===
# paste your analytics snippet (umami, ga, pixel, etc) as raw html
# it will be injected into the <head> of every page
# example: <script defer data-site-id="xxx" src="https://analytics.example.com/umami.js"></script>
ANALYTICS_HTML=

# === server ===
PORT=3000
# comma-separated origins for cors, or * for all
CORS_ORIGINS=*

# === database (required) ===
POSTGRESQL_URI=postgresql://user:password@localhost:5432/litter
POSTGRESQL_MAX_CONNECTIONS=10

# === auth tokens ===
# api tokens for authenticated endpoints (upload, delete, operations)
# json array: ["token1", "token2"]
# or comma-separated: token1,token2
TOKENS=["generate-with-litter-cli"]

# lock down the entire /api surface (every route needs a bearer token)
# when false (default), only admin routes (delete, operations, stats) require auth
# warning: setting true breaks the web ui uploader - it has no api key support
REQUIRE_API_AUTH=false

# === telegram storage backend (required) ===
# get credentials from https://my.telegram.org/apps
TELEGRAM_CHAT_ID=your_chat_id

# account 1 (or use generic vars without _1 suffix)
TELEGRAM_API_ID_1=your_api_id
TELEGRAM_API_HASH_1=your_api_hash
TELEGRAM_PHONE_1=+1234567890
TELEGRAM_PASSWORD_1=

# account 2 (optional, for multi-account load balancing)
# TELEGRAM_API_ID_2=
# TELEGRAM_API_HASH_2=
# TELEGRAM_PHONE_2=
# TELEGRAM_PASSWORD_2=

# session file paths (optional, defaults to ./telegram-account1.session)
# TELEGRAM_SESSION_PATH=./session.session

# mtproto bots (optional, any mix with user accounts; reuses api id/hash above)
# same caps as users over mtproto: 2gb upload, unlimited download per file
# get bot tokens from @botfather
# TELEGRAM_BOT_TOKEN_1=
# TELEGRAM_BOT_TOKEN_2=
# TELEGRAM_BOT_SESSION_PATH_1=./telegram-bot1.session

# === optional features ===
# nsfw scanning (requires a nudenet api server)
# NUDENET_API_URL=http://localhost:8080

# translation (nvidia nim api)
# NVIDIA_BUILD_API=

# cache directory (optional, defaults to ./cache)
# CACHE_DIR=

# === logging ===
LOG=true
LOG_FILE=./logs/app.log
# DEBUG=false
